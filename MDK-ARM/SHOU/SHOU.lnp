--cpu Cortex-M3
"shou\startup_stm32f103xb.o"
"shou\main.o"
"shou\gpio.o"
"shou\spi.o"
"shou\stm32f1xx_it.o"
"shou\stm32f1xx_hal_msp.o"
"shou\nrf24l01.o"
"shou\jy901s.o"
"shou\handheld.o"
"shou\oled.o"
"shou\stm32f1xx_hal_gpio_ex.o"
"shou\stm32f1xx_hal_spi.o"
"shou\stm32f1xx_hal.o"
"shou\stm32f1xx_hal_rcc.o"
"shou\stm32f1xx_hal_rcc_ex.o"
"shou\stm32f1xx_hal_gpio.o"
"shou\stm32f1xx_hal_dma.o"
"shou\stm32f1xx_hal_cortex.o"
"shou\stm32f1xx_hal_pwr.o"
"shou\stm32f1xx_hal_flash.o"
"shou\stm32f1xx_hal_flash_ex.o"
"shou\stm32f1xx_hal_exti.o"
"shou\stm32f1xx_hal_uart.o"
